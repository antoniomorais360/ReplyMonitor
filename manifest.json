{
  "manifest_version": 3,
  "name": "Reply Monitor",
  "short_name": "ReplyMonitor",
  "author": "Antonio Morais and Lin Han",
  "homepage_url": "https://addons.thunderbird.net/en-US/thunderbird/addon/replymonitor/",
  "description": "Track sent messages, detect replies, set due dates, and compose follow-ups. Local-only, with no data collection.",
  "version": "1.5.20",
  "browser_specific_settings": {
    "gecko": {
      "id": "replymonitor@antoniomorais360.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "action": {
    "default_title": "ReplyMonitor",
    "allowed_spaces": ["mail", "calendar", "tasks", "addressbook"],
    "default_icon": {
      "16": "icons/reply-monitor.svg",
      "32": "icons/reply-monitor.svg",
      "48": "icons/reply-monitor.svg"
    }
  },
  "icons": {
    "16": "icons/reply-monitor.svg",
    "32": "icons/reply-monitor.svg",
    "48": "icons/reply-monitor.svg"
  },
  "message_display_action": {
    "default_popup": "popup/track.html",
    "default_title": "Track reply",
    "default_icon": {
      "16": "icons/reply-monitor-track.svg",
      "32": "icons/reply-monitor-track.svg",
      "48": "icons/reply-monitor-track.svg"
    }
  },
  "compose_action": {
    "default_popup": "compose/track.html",
    "default_title": "Track reply",
    "default_icon": {
      "16": "icons/reply-monitor-track.svg",
      "32": "icons/reply-monitor-track.svg",
      "48": "icons/reply-monitor-track.svg"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "messagesRead",
    "accountsRead",
    "menus",
    "tabs",
    "alarms",
    "notifications",
    "compose"
  ]
}
