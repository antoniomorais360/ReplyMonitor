{
  "manifest_version": 3,
  "name": "Reply Monitor",
  "description": "Track sent messages and the replies you expect.",
  "version": "1.5.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "replymonitor@antoniomorais360.github.io",
      "strict_min_version": "140.0"
    }
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "action": {
    "default_title": "ReplyMonitor",
    "default_icon": {
      "16": "icons/reply-monitor.svg",
      "32": "icons/reply-monitor.svg",
      "48": "icons/reply-monitor.svg"
    }
  },
  "icons": {
    "16": "icons/reply-monitor.svg",
    "32": "icons/reply-monitor.svg",
    "48": "icons/reply-monitor.svg"
  },
  "message_display_action": {
    "default_popup": "popup/track.html",
    "default_title": "Track reply"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "messagesRead",
    "accountsRead",
    "menus",
    "tabs",
    "alarms",
    "notifications",
    "compose"
  ]
}
